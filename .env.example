# Copy to .env for local development. Never commit .env.

# Local Postgres (docker compose). Dev-only placeholder credentials.
POSTGRES_USER=skinsync
POSTGRES_PASSWORD=skinsync
POSTGRES_DB=skinsync
POSTGRES_PORT=5433

# App settings
DATABASE_URL=postgresql+psycopg://skinsync:skinsync@localhost:5433/skinsync
APP_ENV=local

# NCBI E-utilities (PMC loader). NCBI asks callers to identify themselves.
NCBI_EMAIL=
# Optional: raises the rate limit from 3 to 10 requests/s.
NCBI_API_KEY=
